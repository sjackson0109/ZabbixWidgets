{
  "name": "zabbixwidgets",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Zabbix dashboard widgets built on Apache ECharts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "lint:php": "node scripts/lint-php.mjs",
    "test": "vitest run",
    "test:browser": "node tests/browser/bundle.browser.mjs",
    "docs:contracts": "node scripts/contracts-doc.mjs",
    "licences": "node scripts/licence-inventory.mjs",
    "audit:provenance": "node scripts/provenance-audit.mjs",
    "audit:similarity": "node scripts/similarity-audit.mjs",
    "package": "node scripts/package.mjs",
    "check": "npm run lint && npm run lint:php && npm test && npm run build && npm run test:browser && npm run docs:contracts -- --check && npm run licences && npm run audit:provenance"
  },
  "dependencies": {
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "vitest": "5.0.3"
  }
}
